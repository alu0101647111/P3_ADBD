        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    VIVERO ||--o{ ZONA : \&quot;tiene\&quot;\n    ZONA ||--o{ STOCK : \&quot;aloja\&quot;\n    PRODUCTO ||--o{ STOCK : \&quot;está en\&quot;\n    EMPLEADO ||--o{ HISTORICO_DESTINO : \&quot;historial\&quot;\n    TAREA ||--o{ HISTORICO_DESTINO : \&quot;asignada en\&quot;\n    ZONA ||--o{ HISTORICO_DESTINO : \&quot;ocurre en\&quot;\n    CLIENTE ||--o| CLIENTE_PLUS : \&quot;es (ISA)\&quot;\n    CLIENTE_PLUS ||--o{ BONIFICACION : \&quot;recibe\&quot;\n    CLIENTE ||--o{ PEDIDO : \&quot;realiza\&quot;\n    EMPLEADO ||--o{ PEDIDO : \&quot;gestiona\&quot;\n    PEDIDO ||--|{ LINEA_PEDIDO : \&quot;incluye\&quot;\n    PRODUCTO ||--o{ LINEA_PEDIDO : \&quot;contiene\&quot;\n\n    VIVERO {\n        int ID_vivero PK\n        string Nombre\n        float Latitud\n        float Longitud\n    }\n    ZONA {\n        int ID_vivero PK,FK\n        int ID_zona PK\n        string Nombre\n        string Tipo\n        float Latitud\n        float Longitud\n    }\n    STOCK {\n        int ID_vivero PK,FK\n        int ID_zona PK,FK\n        int ID_producto PK,FK\n        int Cantidad\n    }\n    PRODUCTO {\n        int ID_producto PK\n        string Nombre\n        float Precio\n    }\n    EMPLEADO {\n        int ID_empleado PK\n        string Nombre\n        string Apellidos\n        date Fecha_alta\n    }\n    HISTORICO_DESTINO {\n        int ID_empleado PK,FK\n        int ID_tarea PK,FK\n        int ID_vivero PK,FK\n        int ID_zona PK,FK\n        date Fecha_inicio PK\n        date Fecha_fin\n        string Puesto\n        float Productividad\n    }\n    TAREA {\n        int ID_tarea PK\n        string Nombre\n        string Descripcion\n    }\n    CLIENTE {\n        int ID_cliente PK\n        string Nombre\n    }\n    CLIENTE_PLUS {\n        int ID_cliente PK,FK\n        date Fecha_ingreso\n        date Fecha_baja\n    }\n    BONIFICACION {\n        int ID_cliente PK,FK\n        int ID_bonificacion PK\n        string Mes\n        float Importe\n        float Volumen_compra \&quot;Derivado\&quot;\n    }\n    PEDIDO {\n        int ID_pedido PK\n        int ID_cliente FK\n        int ID_empleado FK\n        date Fecha\n        float Importe_total \&quot;Derivado\&quot;\n    }\n    LINEA_PEDIDO {\n        int ID_pedido PK,FK\n        int ID_producto PK,FK\n        int Cantidad\n        float Precio_venta\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="HWfHdieozi0sInPscAUA-1">
